rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One doc per username (doc id = lowercase name). Claiming it is what makes a name unique.
    match /usernames/{name} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && name.matches('^[a-z0-9_]{3,16}$')
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name.lower() == name
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt']);
      allow update, delete: if false;
    }

    // Private per-user profile + game history.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.usernameLower.matches('^[a-z0-9_]{3,16}$')
                    && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.usernameLower == resource.data.usernameLower;
      allow delete: if false;
    }

    // Public leaderboard entry (one doc per player).
    match /leaderboard/{uid} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'photoURL', 'best', 'updatedAt'])
                    && request.resource.data.keys().hasAll(['username', 'usernameLower', 'photoURL', 'best', 'updatedAt'])
                    && request.resource.data.username is string
                    && request.resource.data.usernameLower is string
                    && request.resource.data.usernameLower.matches('^[a-z0-9_]{3,16}$')
                    && request.resource.data.photoURL is string
                    && request.resource.data.photoURL.size() <= 20000
                    && request.resource.data.best is number
                    && request.resource.data.best >= 0
                    && request.resource.data.best <= 1000000
                    && request.resource.data.updatedAt == request.time
                    && get(/databases/$(database)/documents/users/$(uid)).data.username == request.resource.data.username
                    && get(/databases/$(database)/documents/users/$(uid)).data.usernameLower == request.resource.data.usernameLower;
      allow delete: if false;
    }

    // DAILY RUN ranks: daily/{dayNumber}/entries/{uid}  (one UTC day per path, so the board "resets" by itself)
    // - Any signed-in player can read.
    // - Create once, only for TODAY by the SERVER clock. No update, no delete.
    // - The day check uses plain integer comparisons (no division / string() / float rounding).
    match /daily/{day}/entries/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
                    && day.matches('^[0-9]{1,6}$')
                    && request.time.toMillis() >= int(day) * 86400000
                    && request.time.toMillis() < (int(day) + 1) * 86400000
                    && request.resource.data.keys().hasOnly(['username', 'usernameLower', 'photoURL', 'score', 'wave', 'grid', 'day', 'createdAt', 'expireAt'])
                    && request.resource.data.keys().hasAll(['username', 'usernameLower', 'photoURL', 'score', 'wave', 'grid', 'day', 'createdAt', 'expireAt'])
                    && request.resource.data.day == int(day)
                    && request.resource.data.username is string
                    && request.resource.data.usernameLower is string
                    && request.resource.data.usernameLower.matches('^[a-z0-9_]{3,16}$')
                    && request.resource.data.photoURL is string
                    && request.resource.data.photoURL.size() <= 600
                    && request.resource.data.score is number
                    && request.resource.data.score >= 0
                    && request.resource.data.score <= 1000000
                    && request.resource.data.wave is number
                    && request.resource.data.wave >= 1
                    && request.resource.data.wave <= 300
                    && request.resource.data.grid is string
                    && request.resource.data.grid.size() <= 60
                    && request.resource.data.grid.matches('^[GYR]*$')
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.expireAt is timestamp
                    && get(/databases/$(database)/documents/users/$(uid)).data.username == request.resource.data.username
                    && get(/databases/$(database)/documents/users/$(uid)).data.usernameLower == request.resource.data.usernameLower;
      allow update, delete: if false;
    }
  }

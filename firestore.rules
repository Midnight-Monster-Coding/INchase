rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // One doc per username (doc id = lowercase name). Claiming it is what makes a name unique.
    match /usernames/{name} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && name.matches('^[a-z0-9_]{3,16}$')
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name.lower() == name
                    && request.resource.data.keys().hasOnly(['uid', 'name', 'createdAt']);
      allow update, delete: if false;
    }

    // Private per-user profile + game history.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.usernameLower.matches('^[a-z0-9_]{3,16}$')
                    && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == request.auth.uid;
      allow update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.usernameLower == resource.data.usernameLower;
      allow delete: if false;
    }
  }
}
